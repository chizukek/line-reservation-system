<%- include("partials/header", {
title: "患者検索",
isAdminPage: true,
isAdminLoggedIn: true
}) %>

<%
const getDoctorColorClass = (reservation) => {
if (!reservation) {
return "";
}

const reservationDoctorId = Number(
reservation.doctorId ||
reservation.doctor?.id
);

if (reservationDoctorId === 1) {
return "color_A";
}

if (reservationDoctorId === 2) {
return "color_B";
}

return "";
};

const getDoctorName = (reservation) => {
if (
!reservation ||
!reservation.doctor
) {
return "";
}

return (
reservation.doctor.displayName ||
reservation.doctor.name ||
""
);
};

const patientList =
Array.isArray(patients)
? patients
: [];

const searchKeyword =
typeof keyword !== "undefined"
? String(keyword || "").trim()
: "";
%>

<div class="admin-page">

  <div class="admin-card">


<header class="admin-page-header">

  <div>

    <h1>
      患者検索
    </h1>

  </div>

</header>

<% if (
  typeof error !== "undefined" &&
  error
) { %>

  <div
    class="clinic-error"
    role="alert"
  >
    <%= error %>
  </div>

<% } %>

<!-- =========================
     患者検索
========================== -->

<section class="admin-panel">

  <form
    class="admin-search-form"
    action="/admin/patients"
    method="get"
  >

    <label class="admin-search-field">

      <span class="admin-field-label">
        患者番号または氏名
      </span>

      <input
        type="search"
        name="keyword"
        value="<%= searchKeyword %>"
        placeholder="患者番号または氏名を入力"
        autocomplete="off"
      >

    </label>

    <button
      class="admin-primary-button"
      type="submit"
    >
      検索
    </button>

  </form>

</section>

<!-- =========================
     検索結果
========================== -->

<% if (searchKeyword) { %>

  <section class="admin-panel">

    <div class="admin-section-title-row">

      <h2 class="admin-panel-title">
        検索結果
      </h2>

      <span class="admin-result-count">
        <%= patientList.length %>件
      </span>

    </div>

    <% if (patientList.length === 0) { %>

      <div class="admin-empty">
        「<%= searchKeyword %>」に一致する患者はいません。
      </div>

      <div class="clinic-actions">

        <a
          class="admin-primary-button"
          href="/admin/patients/add"
        >
          新規患者登録する
        </a>

      </div>

    <% } else { %>

      <div class="admin-table-wrapper">

        <table class="admin-table admin-patient-table">

          <thead>

            <tr>
              <th>患者番号</th>
              <th>氏名</th>
              <th>電話番号</th>
              <th>現在の予約</th>
              <th>詳細</th>
            </tr>

          </thead>

          <tbody>

            <% patientList.forEach((patient) => { %>

              <%
              const reservation =
                Array.isArray(patient.reservations) &&
                patient.reservations.length > 0
                  ? patient.reservations[0]
                  : null;

              const doctorClass =
                getDoctorColorClass(reservation);

              const reservationDoctorName =
                getDoctorName(reservation);

              const slotDetailUrl =
                reservation
                  ? (
                      `/admin/slot?doctorId=${encodeURIComponent(
                        reservation.doctorId
                      )}` +
                      `&date=${encodeURIComponent(
                        reservation.date
                      )}` +
                      `&slot=${encodeURIComponent(
                        reservation.slot
                      )}`
                    )
                  : "";
              %>

              <tr>

                <td>

                  <strong>
                    <%= patient.patientNumber %>
                  </strong>

                </td>

                <td>
                  <%= patient.name %>
                </td>

                <td>
                  <%= patient.phone || patient.phoneNumber || "−" %>
                </td>

                <td>

                  <% if (reservation) { %>

                    <a
                      class="admin-reservation-link"
                      href="<%= slotDetailUrl %>"
                      aria-label="予約枠詳細を表示"
                    >

                      <span class="admin-current-reservation">

                        <strong>
                          <%= formatJapaneseDateShort(
                            reservation.date
                          ) %>
                        </strong>

                        <span>
                          <%= typeof getSlotLabel === "function"
                            ? getSlotLabel(
                                reservation.slot,
                                reservation.doctorId
                              )
                            : reservation.slot
                          %>
                        </span>

                        <% if (reservationDoctorName) { %>

                          <span class="admin-doctor-label">

                            <span
                              class="admin-doctor-dot <%= doctorClass %>"
                              aria-hidden="true"
                            ></span>

                            <%= reservationDoctorName %>

                          </span>

                        <% } %>

                      </span>

                    </a>

                  <% } else { %>

                    <span class="admin-no-reservation">
                      予約なし
                    </span>

                  <% } %>

                </td>

                <td>

                  <a
                    class="admin-row-button"
                    href="/admin/patients/<%= patient.id %>"
                  >
                    詳細
                  </a>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </section>

<% } else { %>

  <div class="admin-empty">
    患者番号または氏名を入力して検索してください。
  </div>

<% } %>


  </div>

</div>

<%- include("partials/footer", {
isAdminPage: true,
isAdminLoggedIn: true
}) %>
