<%- include("partials/header", {
  title: "予約変更確認",
  isAdminPage: true,
  isAdminLoggedIn
}) %>

<%
  const oldDoctor =
    reservation.doctor ||
    doctor ||
    {};

  const newDoctor =
    doctor ||
    reservation.doctor ||
    {};

  const oldDoctorName =
    oldDoctor.displayName ||
    oldDoctor.name ||
    "";

  const newDoctorName =
    newDoctor.displayName ||
    newDoctor.name ||
    "";

  const oldDoctorColorClass =
    Number(oldDoctor.id) === 1
      ? "is-doctor-one"
      : "is-doctor-two";

  const newDoctorColorClass =
    Number(newDoctor.id) === 1
      ? "is-doctor-one"
      : "is-doctor-two";

  const patient =
    reservation.patient || {};

  const patientNumber =
    patient.patientNumber ||
    reservation.patientNumber ||
    "";

  const patientName =
    patient.name || "";
%>

<div class="admin-page admin-edit-confirm-page">
  <div class="admin-card">

    <header class="admin-page-header">

      <div>

        <p class="admin-page-eyebrow">
          予約管理
        </p>

        <h1>
          予約変更確認
        </h1>

        <p class="admin-page-description">
          変更内容を確認して、「予約を変更する」を押してください。
        </p>

      </div>

    </header>

    <section class="admin-panel">

      <h2 class="admin-panel-title">
        変更前
      </h2>

      <div class="admin-list-table-shell">

        <table class="admin-info-table">

          <thead>
            <tr>
              <th>予約日</th>
              <th>時間</th>
              <th>担当医</th>
              <th>患者番号</th>
              <th>患者氏名</th>
            </tr>
          </thead>

          <tbody>
            <tr>

              <td>
                <%= formatJapaneseDate(
                  reservation.date
                ) %>
              </td>

              <td>
                <%= getSlotLabel(
                  reservation.slot,
                  reservation.doctorId
                ) %>
              </td>

              <td>

                <span
                  class="admin-doctor-label"
                  aria-label="担当医 <%= oldDoctorName %>"
                >

                  <span
                    class="admin-doctor-dot <%= oldDoctorColorClass %>"
                    aria-hidden="true"
                  ></span>

                  <%= oldDoctorName %>

                </span>

              </td>

              <td>
                <%= patientNumber %>
              </td>

              <td>
                <strong>
                  <%= patientName %>
                </strong>
              </td>

            </tr>
          </tbody>

        </table>

      </div>

    </section>

    <div
      class="admin-change-arrow"
      aria-hidden="true"
    >
      ↓
    </div>

    <section class="admin-panel is-new">

      <h2 class="admin-panel-title">
        変更後
      </h2>

      <div class="admin-list-table-shell">

        <table class="admin-info-table">

          <thead>
            <tr>
              <th>予約日</th>
              <th>時間</th>
              <th>担当医</th>
              <th>患者番号</th>
              <th>患者氏名</th>
            </tr>
          </thead>

          <tbody>
            <tr>

              <td>
                <strong>
                  <%= formatJapaneseDate(date) %>
                </strong>
              </td>

              <td>
                <strong>
                  <%= slotLabel %>
                </strong>
              </td>

              <td>

                <span
                  class="admin-doctor-label"
                  aria-label="担当医 <%= newDoctorName %>"
                >

                  <span
                    class="admin-doctor-dot <%= newDoctorColorClass %>"
                    aria-hidden="true"
                  ></span>

                  <strong>
                    <%= newDoctorName %>
                  </strong>

                </span>

              </td>

              <td>
                <%= patientNumber %>
              </td>

              <td>
                <strong>
                  <%= patientName %>
                </strong>
              </td>

            </tr>
          </tbody>

        </table>

      </div>

    </section>

    <div
      class="admin-confirm-notice"
      role="note"
    >
      変更を確定すると、元の予約日時は変更後の日時に置き換わります。
    </div>

    <div class="admin-slot-footer-actions">

  <form
    method="POST"
    action="/admin/edit/<%= reservation.id %>/complete"
    class="admin-footer-form"
  >

    <input
      type="hidden"
      name="date"
      value="<%= date %>"
    >

    <input
      type="hidden"
      name="slot"
      value="<%= slot %>"
    >

    <button
      type="submit"
      class="admin-primary-button admin-footer-button"
    >
      変更を確定する
    </button>

  </form>

  <a
    class="admin-secondary-button admin-footer-button"
    href="/admin/reservations?week=0&editReservationId=<%= reservation.id %>"
  >
    日時を選び直す
  </a>

  <a
    class="admin-secondary-button admin-footer-button"
   href="/admin/slot?doctorId=<%= reservation.doctorId %>&date=<%= encodeURIComponent(reservation.date) %>&slot=<%= encodeURIComponent(reservation.slot) %>"
    >変更を中止する
  </a>

</div>

  </div>
</div>

<%- include("partials/footer", {
  isAdminPage: true,
  isAdminLoggedIn
}) %>