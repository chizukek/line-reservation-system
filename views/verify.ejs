<%- include("partials/header", { title: "予約情報の確認" }) %>

<%
const currentYear = new Date().getFullYear();
%>

<div class="clinic-page">
  <div class="clinic-card login-card">

    <h1>予約情報の確認</h1>

    <p class="clinic-lead">
      現在の予約状況を確認するため、患者番号と生年月日を患者データと照合します。
    </p>

    <% if (typeof error !== "undefined" && error) { %>
      <div class="clinic-error" role="alert">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/verify" class="clinic-form">

      <label for="patientNumber">
        患者番号

        <input
          id="patientNumber"
          name="patientNumber"
          type="text"
          inputmode="numeric"
          pattern="[0-9]{5}"
          maxlength="5"
          autocomplete="off"
          required
        >

        <span class="patient-number-help">
          <span aria-hidden="true">！</span>
          患者番号は、診療カードに記載されている患者番号です。
        </span>
      </label>

      <p class="patient-number-unknown">
        <a href="/phone-reservation">
          患者番号が分からない方はこちら
        </a>
      </p>

      <label>
        <span>生年月日</span>

        <div class="birth-select">
          <select
            id="birthYear"
            name="birthYear"
            required
          >
            <% for (let y = currentYear; y >= 1900; y--) { %>
              <option value="<%= y %>">
                <%= y %>年
              </option>
            <% } %>
          </select>

          <select
            name="birthMonth"
            required
          >
            <% for (let m = 1; m <= 12; m++) { %>
              <option value="<%= m %>">
                <%= m %>月
              </option>
            <% } %>
          </select>

          <select
            name="birthDay"
            required
          >
            <% for (let d = 1; d <= 31; d++) { %>
              <option value="<%= d %>">
                <%= d %>日
              </option>
            <% } %>
          </select>
        </div>
      </label>

      <button type="submit" class="clinic-main-button">
        現在の予約を確認する
      </button>

      <a class="clinic-sub-button" href="/psychiatry">
        戻る
      </a>

    </form>

  </div>
</div>

<script>
window.addEventListener("DOMContentLoaded", () => {
  const birthYearSelect = document.getElementById("birthYear");

  if (birthYearSelect) {
    birthYearSelect.value = "1990";
  }
});
</script>

<%- include("partials/footer") %>
