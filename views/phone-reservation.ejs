<%- include("partials/header", {
  title:
    typeof title !== "undefined"
      ? title
      : "お電話でのご予約"
}) %>

<%
  const phoneNumber =
    typeof clinicPhone !== "undefined"
      ? String(clinicPhone || "").trim()
      : "";

  /*
   * telリンク用に、
   * 数字と先頭の+以外を取り除きます。
   */
  const phoneHref =
    phoneNumber
      ? phoneNumber.replace(/[^\d+]/g, "")
      : "";
%>

<div class="clinic-page">

  <div class="clinic-card login-card">

    <h1>
      <%= typeof heading !== "undefined"
        ? heading
        : "本人確認が一時中断されました"
      %>
    </h1>

    <div
      class="clinic-error"
      role="alert"
    >

      <p>
        <%= typeof message !== "undefined"
          ? message
          : "ログイン試行回数が一定数を超えたため、本人確認が一時中断されました。お手数ですが、お電話にてご予約ください。"
        %>
      </p>

    </div>

    <% if (phoneNumber) { %>

      <section class="clinic-section">

        <h2>
          ご予約・お問い合わせ
        </h2>

        <div class="clinic-phone-box">

          <span class="clinic-phone-label">
            電話番号
          </span>

          <a
            class="clinic-phone-number"
            href="tel:<%= phoneHref %>"
          >
            <%= phoneNumber %>
          </a>

        </div>

      </section>

    <% } else { %>

      <div
        class="clinic-error"
        role="alert"
      >
        医院の電話番号が設定されていません。
      </div>

    <% } %>

    <div class="clinic-actions">

      <a
        class="clinic-sub-button"
        href="/psychiatry"
      >
        最初の画面へ戻る
      </a>

    </div>

  </div>

</div>

<%- include("partials/footer") %>