<%- include("partials/header", {
title:
typeof title !== "undefined"
? title
: "予約スケジュール",
isAdminPage: true,
isAdminLoggedIn,
doctor,
doctors
}) %>

<%
/*

* ==============================
* 表示モード
* ==============================
  */

const changeReservation =
typeof editReservation !== "undefined"
? editReservation
: null;

const changeReservationId =
changeReservation
? Number(changeReservation.id)
: 0;

const isEditMode =
Number.isInteger(changeReservationId) &&
changeReservationId > 0;

const reservationPatient =
typeof selectedPatient !== "undefined"
? selectedPatient
: null;

const selectedPatientNumber =
reservationPatient
? String(reservationPatient.patientNumber)
: "";

const isAddMode =
!isEditMode &&
Boolean(reservationPatient);

const isNormalMode =
!isEditMode &&
!isAddMode;

/*

* ==============================
* 担当医表示
* ==============================
  */

const currentDoctorName =
doctor.displayName ||
doctor.name ||
"";

const currentDoctorColorClass =
Number(doctor.id) === 1
? "is-doctor-one"
: Number(doctor.id) === 2
? "is-doctor-two"
: "";

/*

* ==============================
* 日付処理
* ==============================
  */

const getDateText = (value) => {
if (!value) {
return "";
}


if (
  typeof value === "string" &&
  /^\d{4}-\d{2}-\d{2}/.test(value)
) {
  return value.slice(0, 10);
}

const dateObject =
  new Date(value);

if (
  Number.isNaN(
    dateObject.getTime()
  )
) {
  return "";
}

return new Intl.DateTimeFormat(
  "sv-SE",
  {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
  }
).format(dateObject);


};

const formatShortDate = (value) => {
const dateText =
getDateText(value);


if (!dateText) {
  return "";
}

const [year, month, day] =
  dateText
    .split("-")
    .map(Number);

const dateObject =
  new Date(
    year,
    month - 1,
    day
  );

const weekdays = [
  "日",
  "月",
  "火",
  "水",
  "木",
  "金",
  "土"
];

return (
  `${month}/${day}` +
  `(${weekdays[dateObject.getDay()]})`
);


};

/*

* ==============================
* 表示期間
* ==============================
  */

const startDate =
dates.length > 0
? getDateText(
dates[0].value
)
: "";

const endDate =
dates.length > 0
? getDateText(
dates[
dates.length - 1
].value
)
: "";

const periodLabel =
startDate && endDate
? `${formatShortDate(startDate)} 〜 ${formatShortDate(endDate)}`
: "";

/*

* ==============================
* 週送りクエリ
* ==============================
  */

let modeQuery = "";

if (isEditMode) {
modeQuery =
"&editReservationId=" +
encodeURIComponent(
String(
changeReservationId
)
);
} else if (isAddMode) {
modeQuery =
"&patientNumber=" +
encodeURIComponent(
selectedPatientNumber
);
}

const previousWeekUrl =
week > 0
? (
"/admin/reservations?week=" +
(week - 1) +
modeQuery
)
: null;

const nextWeekUrl =
canGoNextWeek
? (
"/admin/reservations?week=" +
(week + 1) +
modeQuery
)
: null;

/*

* ==============================
* 見出し
* ==============================
  */

const pageEyebrow =
isEditMode
? "予約変更"
: isAddMode
? "予約追加"
: "予約管理";

const pageHeading =
isEditMode
? "変更後の日時を選択"
: isAddMode
? "予約日時を選択"
: "予約スケジュール";
%>

<div class="admin-page admin-reservations-page">

  <div class="admin-card">


<header class="admin-page-header">

  <div>

    <p class="admin-page-eyebrow">
      <%= pageEyebrow %>
    </p>

    <h1>
      <%= pageHeading %>
    </h1>

    <p class="admin-page-description">

      担当医：

      <strong>

        <span
          class="admin-doctor-label"
          aria-label="担当医 <%= currentDoctorName %>"
        >

          <span
            class="admin-doctor-dot <%= currentDoctorColorClass %>"
            aria-hidden="true"
          ></span>

          <%= currentDoctorName %>

        </span>

      </strong>

    </p>

  </div>

  <% if (isEditMode) { %>

    <a
      class="admin-week-button"
      href="/admin/reservations?week=<%= week %>"
    >
      変更を中止
    </a>

  <% } else if (isAddMode) { %>

    <a
      class="admin-week-button"
      href="/admin/reservation-add?keyword=<%= encodeURIComponent(selectedPatientNumber) %>"
    >
      予約追加を中止
    </a>

  <% } %>

</header>

<% if (isEditMode) { %>

  <%
    const changeDoctor =
      changeReservation.doctor ||
      doctor;

    const changeDoctorName =
      changeDoctor.displayName ||
      changeDoctor.name ||
      currentDoctorName;

    const changeDoctorColorClass =
      Number(changeDoctor.id) === 1
        ? "is-doctor-one"
        : Number(changeDoctor.id) === 2
          ? "is-doctor-two"
          : "";
  %>

  <section class="admin-panel">

    <h2 class="admin-panel-title">
      変更対象の予約
    </h2>

    <div class="admin-table-wrapper">

      <table class="admin-table admin-patient-table">

        <thead>
          <tr>
            <th>患者番号</th>
            <th>患者氏名</th>
            <th>担当医</th>
            <th>予約日</th>
            <th>時間</th>
          </tr>
        </thead>

        <tbody>

          <tr>

            <td>
              <strong>
                <%= changeReservation.patientNumber %>
              </strong>
            </td>

            <td>
              <%= changeReservation.patient.name %>
            </td>

            <td>

              <span
                class="admin-doctor-label"
                aria-label="担当医 <%= changeDoctorName %>"
              >

                <span
                  class="admin-doctor-dot <%= changeDoctorColorClass %>"
                  aria-hidden="true"
                ></span>

                <%= changeDoctorName %>

              </span>

            </td>

            <td>
              <%= formatShortDate(
                changeReservation.date
              ) %>
            </td>

            <td>
              <%= getSlotLabel(
                changeReservation.slot,
                changeReservation.doctorId
              ) %>
            </td>

          </tr>

        </tbody>

      </table>

    </div>

  </section>

<% } else if (isAddMode) { %>

  <section class="admin-panel">

    <h2 class="admin-panel-title">
      予約を追加する患者
    </h2>

    <div class="admin-list-table-shell">

      <table class="admin-info-table">

        <thead>
          <tr>
            <th>患者番号</th>
            <th>患者氏名</th>
            <th>現在の予約</th>
          </tr>
        </thead>

        <tbody>

          <tr>

            <td>

              <strong>
                <%= reservationPatient.patientNumber %>
              </strong>

            </td>

            <td>
              <%= reservationPatient.name %>
            </td>

            <td>

              <%
                const currentReservations =
                  Array.isArray(
                    reservationPatient.reservations
                  )
                    ? reservationPatient.reservations
                    : [];

                const currentReservation =
                  currentReservations[0] ||
                  null;
              %>

              <% if (currentReservation) { %>

                <a
                  class="admin-reservation-link"
                  href="/admin/slot?date=<%= encodeURIComponent(getDateText(currentReservation.date)) %>&slot=<%= encodeURIComponent(currentReservation.slot) %>"
                >
                  <%= formatShortDate(
                    currentReservation.date
                  ) %>

                  <%= getSlotLabel(
                    currentReservation.slot,
                    currentReservation.doctorId
                  ) %>
                </a>

              <% } else { %>

                <span class="admin-no-reservation">
                  予約なし
                </span>

              <% } %>

            </td>

          </tr>

        </tbody>

      </table>

    </div>

    <p class="admin-panel-note">
      空いている予約枠を選択してください。
    </p>

  </section>

<% } %>

<section class="admin-panel admin-schedule-panel">

  <div class="admin-schedule-toolbar">

    <div class="admin-toolbar-left">

      <% if (previousWeekUrl) { %>

        <a
          class="admin-week-button"
          href="<%= previousWeekUrl %>"
        >
          ‹ 前の週
        </a>

      <% } else { %>

        <span
          class="admin-week-button is-disabled"
          aria-disabled="true"
        >
          ‹ 前の週
        </span>

      <% } %>

    </div>

    <div class="admin-toolbar-center">

      <span class="admin-schedule-period-label">
        表示期間
      </span>

      <strong>
        <%= periodLabel %>
      </strong>

    </div>

    <div class="admin-toolbar-right">

      <% if (nextWeekUrl) { %>

        <a
          class="admin-week-button is-primary"
          href="<%= nextWeekUrl %>"
        >
          次の週 ›
        </a>

      <% } else { %>

        <span
          class="admin-week-button is-disabled"
          aria-disabled="true"
        >
          次の週 ›
        </span>

      <% } %>

    </div>

  </div>

  <div class="admin-calendar-shell">

    <table class="admin-calendar-table">

      <thead>

        <tr>

          <th class="admin-calendar-time-head">
            時間
          </th>

          <% dates.forEach((dateItem) => { %>

            <%
              const dateText =
                getDateText(
                  dateItem.value
                );

              const [year, month, day] =
                dateText
                  .split("-")
                  .map(Number);

              const dateObject =
                new Date(
                  year,
                  month - 1,
                  day
                );

              const dayNumber =
                dateObject.getDay();

              const weekdays = [
                "日",
                "月",
                "火",
                "水",
                "木",
                "金",
                "土"
              ];

              const weekday =
                weekdays[
                  dayNumber
                ];
            %>

            <th
              class="
                admin-calendar-date-head
                <%= dayNumber === 0
                  ? "is-sunday"
                  : ""
                %>
                <%= dayNumber === 6
                  ? "is-saturday"
                  : ""
                %>
              "
            >

              <span class="admin-calendar-date">
                <%= month %>/<%= day %>
              </span>

              <span class="admin-calendar-weekday">
                <%= weekday %>
              </span>

            </th>

          <% }) %>

        </tr>

      </thead>

      <tbody>

        <% slots.forEach((slot) => { %>

          <tr>

            <th class="admin-calendar-time-cell">

              <%= getSlotLabel(
                slot,
                doctorId
              ) %>

            </th>

            <% dates.forEach((dateItem) => { %>

              <%
                const date =
                  getDateText(
                    dateItem.value
                  );

                const settingKey =
                  `${date}_${slot}`;

                const setting =
                  slotSettings[
                    settingKey
                  ] || {
                    isScheduled: false,
                    isOpen: false,
                    isOverride: false,
                    capacity: 0
                  };

                const isScheduled =
                  setting.isScheduled ===
                  true;

                const isOpen =
                  setting.isOpen ===
                  true;

                const capacity =
                  Number(
                    setting.capacity
                  ) || 0;

                const slotReservations =
                  reservations.filter(
                    (reservation) => {
                      const isSameSlot =
                        getDateText(
                          reservation.date
                        ) === date &&
                        reservation.slot ===
                          slot &&
                        Number(
                          reservation.doctorId
                        ) ===
                          Number(doctorId);

                      const isChangeTarget =
                        isEditMode &&
                        Number(
                          reservation.id
                        ) ===
                          changeReservationId;

                      return (
                        isSameSlot &&
                        !isChangeTarget
                      );
                    }
                  );

                const reservationCount =
                  slotReservations.length;

                const remaining =
                  Math.max(
                    0,
                    capacity -
                      reservationCount
                  );

                const isPast =
                  date < today ||
                  isPastReservationSlot(
                    date,
                    slot
                  );

                const isOutsidePeriod =
                  date >
                  maxReservableText;

                const isFull =
                  isOpen &&
                  capacity > 0 &&
                  reservationCount >=
                    capacity;

                /*
                 * 表示する記号は、
                 * ○・△・満だけ。
                 *
                 * 休診・診療対象外・過去枠は
                 * 空欄にします。
                 */
                let status =
                  "closed";

                let statusLabel =
                  "";

                if (
                  isScheduled &&
                  !isPast &&
                  !isOutsidePeriod
                ) {
                  if (!isOpen) {
                    status =
                      "closed";

                    statusLabel =
                      "";
                  } else if (isFull) {
                    status =
                      "full";

                    statusLabel =
                      "満";
                  } else if (
                    remaining === 1
                  ) {
                    status =
                      "few";

                    statusLabel =
                      "△";
                  } else {
                    status =
                      "open";

                    statusLabel =
                      "○";
                  }
                }

                const canSelectChange =
                  isEditMode &&
                  isScheduled &&
                  isOpen &&
                  !isPast &&
                  !isOutsidePeriod &&
                  !isFull;

                const canSelectAdd =
                  isAddMode &&
                  isScheduled &&
                  isOpen &&
                  !isPast &&
                  !isOutsidePeriod &&
                  !isFull;

                const canOpenDetail =
                  isNormalMode &&
                  isScheduled &&
                  !isPast &&
                  !isOutsidePeriod;

                const slotUrl =
                  "/admin/slot?date=" +
                  encodeURIComponent(
                    date
                  ) +
                  "&slot=" +
                  encodeURIComponent(
                    slot
                  );
              %>

              <td
                class="
                  admin-calendar-slot
                  is-<%= status %>
                  <%= setting.isOverride
                    ? "has-override"
                    : ""
                  %>
                  <%= canSelectChange
                    ? "is-change-selectable"
                    : ""
                  %>
                  <%= canSelectAdd
                    ? "is-add-selectable"
                    : ""
                  %>
                "
              >

                <% if (canSelectChange) { %>

                  <form
                    method="post"
                    action="/admin/edit/<%= changeReservationId %>/confirm"
                    class="admin-calendar-change-form"
                  >

                    <input
                      type="hidden"
                      name="date"
                      value="<%= date %>"
                    >

                    <input
                      type="hidden"
                      name="slot"
                      value="<%= slot %>"
                    >

                    <button
                      type="submit"
                      class="admin-calendar-slot-link admin-calendar-slot-button"
                      aria-label="<%= formatShortDate(date) %> <%= getSlotLabel(slot, doctorId) %>へ変更"
                    >

                      <span class="admin-calendar-status">
                        <%= statusLabel %>
                      </span>

                    </button>

                  </form>

                <% } else if (canSelectAdd) { %>

                  <form
                    method="post"
                    action="/admin/slot/patient-register-confirm"
                    class="admin-calendar-change-form"
                  >

                    <input
                      type="hidden"
                      name="patientNumber"
                      value="<%= reservationPatient.patientNumber %>"
                    >

                    <input
                      type="hidden"
                      name="date"
                      value="<%= date %>"
                    >

                    <input
                      type="hidden"
                      name="slot"
                      value="<%= slot %>"
                    >

                    <button
                      type="submit"
                      class="admin-calendar-slot-link admin-calendar-slot-button"
                      aria-label="<%= reservationPatient.name %>さんの予約を<%= formatShortDate(date) %> <%= getSlotLabel(slot, doctorId) %>に追加"
                    >

                      <span class="admin-calendar-status">
                        <%= statusLabel %>
                      </span>

                    </button>

                  </form>

                <% } else if (canOpenDetail) { %>

                  <a
                    class="admin-calendar-slot-link"
                    href="<%= slotUrl %>"
                    aria-label="<%= formatShortDate(date) %> <%= getSlotLabel(slot, doctorId) %>の予約枠詳細"
                  >

                    <% if (statusLabel) { %>

                      <span class="admin-calendar-status">
                        <%= statusLabel %>
                      </span>

                    <% } %>

                  </a>

                <% } else { %>

                  <span class="admin-calendar-slot-disabled">

                    <% if (statusLabel) { %>

                      <span class="admin-calendar-status">
                        <%= statusLabel %>
                      </span>

                    <% } %>

                  </span>

                <% } %>

              </td>

            <% }) %>

          </tr>

        <% }) %>

      </tbody>

    </table>

  </div>

  <p class="admin-schedule-note">

    <% if (isEditMode) { %>

      「○」または「△」の枠をタップすると、変更確認画面へ進みます。

    <% } else if (isAddMode) { %>

      「○」または「△」の枠をタップすると、予約追加確認画面へ進みます。

    <% } else { %>

      「○」「△」「満」の枠をタップすると、予約枠詳細を確認できます。

    <% } %>

  </p>

</section>

<% if (isEditMode) { %>

  <div class="admin-slot-footer-actions">

    <a
      class="admin-week-button"
      href="/admin/reservations?week=<%= week %>"
    >
      変更を中止
    </a>

    <a
      class="admin-week-button"
      href="/admin/slot?date=<%= encodeURIComponent(getDateText(changeReservation.date)) %>&slot=<%= encodeURIComponent(changeReservation.slot) %>"
    >
      元の予約枠へ戻る
    </a>

  </div>

<% } else if (isAddMode) { %>

  <div class="admin-slot-footer-actions">

    <a
      class="admin-week-button"
      href="/admin/reservation-add?keyword=<%= encodeURIComponent(selectedPatientNumber) %>"
    >
      予約追加画面へ戻る
    </a>

  </div>

<% } %>


  </div>

</div>

<%- include("partials/footer", {
isAdminPage: true,
isAdminLoggedIn
}) %>
